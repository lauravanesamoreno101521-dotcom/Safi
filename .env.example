# VITE_SUPABASE_URL: URL del proyecto de Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"

# VITE_SUPABASE_ANON_KEY: llave pública "anon" del proyecto (Project Settings > API > anon public)
# Es segura de exponer en el frontend: el acceso real se controla con las políticas RLS en Supabase.
VITE_SUPABASE_ANON_KEY="tu-anon-key"
